'use strict';

const contactService = require('../services/contact.service');
const AppError = require('../../../utils/appError');

class ContactController {
  async create(req, res, next) {
    try {
      const contact = await contactService.createContact(req.body);
      res.status(201).json(contact);
    } catch (error) {
      // Wrap any unhandled error in AppError if needed
      if (!(error instanceof AppError)) {
        return next(
          new AppError({
            model: 'Contact',
            action: 'create',
            statusCode: 500,
            message: 'Failed to create contact',
            meta: error.errors || error.message
          })
        );
      }
      next(error);
    }
  }

  async list(req, res, next) {
    try {
      const { page, limit, isCustomer, isSupplier } = req.query;

      const filters = {};
      if (isCustomer !== undefined) filters.isCustomer = isCustomer === 'true';
      if (isSupplier !== undefined) filters.isSupplier = isSupplier === 'true';

      const result = await contactService.getContacts({
        page: Number(page) || 1,
        limit: Number(limit) || 10,
        filters
      });

      res.json({
        data: result.rows,
        total: result.count,
        page: Number(page) || 1
      });
    } catch (error) {
      if (!(error instanceof AppError)) {
        return next(
          new AppError({
            model: 'Contact',
            action: 'list',
            statusCode: 500,
            message: 'Failed to list contacts',
            meta: error.errors || error.message
          })
        );
      }
      next(error);
    }
  }

  async getById(req, res, next) {
    try {
      const contact = await contactService.getContactById(req.params.id);
      if (!contact) {
        return next(
          new AppError({
            model: 'Contact',
            action: 'read',
            statusCode: 404,
            message: 'Contact not found'
          })
        );
      }

      res.json(contact);
    } catch (error) {
      if (!(error instanceof AppError)) {
        return next(
          new AppError({
            model: 'Contact',
            action: 'read',
            statusCode: 500,
            message: 'Failed to get contact',
            meta: error.errors || error.message
          })
        );
      }
      next(error);
    }
  }

  async update(req, res, next) {
    try {
      const contact = await contactService.updateContact(req.params.id, req.body);
      res.json(contact);
    } catch (error) {
      if (!(error instanceof AppError)) {
        return next(
          new AppError({
            model: 'Contact',
            action: 'update',
            statusCode: 500,
            message: 'Failed to update contact',
            meta: error.errors || error.message
          })
        );
      }
      next(error);
    }
  }

  async remove(req, res, next) {
    try {
      await contactService.deleteContact(req.params.id);
      res.status(204).send();
    } catch (error) {
      if (!(error instanceof AppError)) {
        return next(
          new AppError({
            model: 'Contact',
            action: 'delete',
            statusCode: 500,
            message: 'Failed to delete contact',
            meta: error.errors || error.message
          })
        );
      }
      next(error);
    }
  }
}

module.exports = new ContactController();
