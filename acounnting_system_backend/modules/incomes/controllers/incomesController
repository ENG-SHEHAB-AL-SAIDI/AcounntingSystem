'use strict';

const incomeService = require('../services/incomeService');
const AppError = require('../../../utils/appError');

class IncomeController {
  async createIncome(req, res, next) {
    try {
      const income = await incomeService.createIncome(req.body);
      res.status(201).json(income);
    } catch (error) {
      // Wrap non-AppError in AppError
      if (!(error instanceof AppError)) {
        return next(
          new AppError({
            model: 'Income',
            action: 'create',
            statusCode: 400,
            message: 'Failed to create income',
            meta: error.errors || error.message
          })
        );
      }
      next(error);
    }
  }

  async getIncomes(req, res, next) {
    try {
      const page = parseInt(req.query.page) || 1;
      const limit = parseInt(req.query.limit) || 10;
      const result = await incomeService.getPaginatedIncomes({ page, limit });
      res.json(result);
    } catch (error) {
      if (!(error instanceof AppError)) {
        return next(
          new AppError({
            model: 'Income',
            action: 'list',
            statusCode: 500,
            message: 'Failed to list incomes',
            meta: error.errors || error.message
          })
        );
      }
      next(error);
    }
  }

  async getIncomeById(req, res, next) {
    try {
      const income = await incomeService.getIncomeById(req.params.id);
      if (!income) {
        return next(
          new AppError({
            model: 'Income',
            action: 'read',
            statusCode: 404,
            message: 'Income not found'
          })
        );
      }
      res.json(income);
    } catch (error) {
      if (!(error instanceof AppError)) {
        return next(
          new AppError({
            model: 'Income',
            action: 'read',
            statusCode: 500,
            message: 'Failed to get income',
            meta: error.errors || error.message
          })
        );
      }
      next(error);
    }
  }

  async updateIncome(req, res, next) {
    try {
      const income = await incomeService.updateIncome(req.params.id, req.body);
      res.json(income);
    } catch (error) {
      if (!(error instanceof AppError)) {
        return next(
          new AppError({
            model: 'Income',
            action: 'update',
            statusCode: 400,
            message: 'Failed to update income',
            meta: error.errors || error.message
          })
        );
      }
      next(error);
    }
  }

  async deleteIncome(req, res, next) {
    try {
      await incomeService.deleteIncome(req.params.id);
      res.status(204).send();
    } catch (error) {
      if (!(error instanceof AppError)) {
        return next(
          new AppError({
            model: 'Income',
            action: 'delete',
            statusCode: 400,
            message: 'Failed to delete income',
            meta: error.errors || error.message
          })
        );
      }
      next(error);
    }
  }
}

module.exports = new IncomeController();
